{
  "name": "truvara-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Truvara MVP backend - modular monolith (Governance, Operations, Finance, Dashboard) on one Role->Permission->Scope RBAC foundation",
  "scripts": {
    "predev": "node scripts/resolve-db-host.js",
    "dev": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first --watch src/server.js",
    "prestart": "node scripts/resolve-db-host.js",
    "start": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first src/server.js",
    "prisma:generate": "prisma generate --schema=prisma/directory/schema.prisma && prisma generate --schema=prisma/tenant/schema.prisma",
    "preprisma:migrate:directory": "node scripts/resolve-db-host.js",
    "prisma:migrate:directory": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma migrate dev --schema=prisma/directory/schema.prisma",
    "preprisma:migrate:tenant": "node scripts/resolve-db-host.js",
    "prisma:migrate:tenant": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "preprisma:deploy:directory": "node scripts/resolve-db-host.js",
    "prisma:deploy:directory": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma migrate deploy --schema=prisma/directory/schema.prisma",
    "preprisma:deploy:tenant": "node scripts/resolve-db-host.js",
    "prisma:deploy:tenant": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma migrate deploy --schema=prisma/tenant/schema.prisma",
    "preprisma:seed": "node scripts/resolve-db-host.js",
    "prisma:seed": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first prisma/seed.js",
    "preseed:real-companies": "node scripts/resolve-db-host.js",
    "seed:real-companies": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first prisma/seedRealCompanies.js",
    "preclear:test-data": "node scripts/resolve-db-host.js",
    "clear:test-data": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first scripts/clearTestData.js",
    "prepartition:shared-db": "node scripts/resolve-db-host.js",
    "partition:shared-db": "HOSTALIASES=$(pwd)/.hostaliases node --dns-result-order=ipv4first scripts/partitionSharedDatabase.js",
    "preprisma:push:directory": "node scripts/resolve-db-host.js",
    "prisma:push:directory": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma db push --schema=prisma/directory/schema.prisma",
    "preprisma:push:tenant": "node scripts/resolve-db-host.js",
    "prisma:push:tenant": "HOSTALIASES=$(pwd)/.hostaliases NODE_OPTIONS=--dns-result-order=ipv4first prisma db push --schema=prisma/tenant/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
