# pool_timeout=0 disables Prisma's internal connection-pool wait timeout (10s
# default) so a slow-but-alive network doesn't get killed by an arbitrary
# app-level cutoff -- only a genuinely dead connection fails now.

# Directory ("control plane") DB -- identity only: Users, Companies, Roles,
# Permissions, CompanyMemberships.
DIRECTORY_DATABASE_URL="postgresql://truvara_directory:changeme@localhost:5432/truvara_directory?schema=public&pool_timeout=0"

# Only used by `prisma generate` (which never connects to the DB) to know the
# tenant schema's shape. NOT read at runtime -- real per-company connections
# are resolved dynamically from Company.tenantDatabaseUrl in the directory DB.
# Do not point this at a non-empty database; `prisma migrate` (unlike
# `generate`) does connect and would try to create tables that may exist.
TENANT_DATABASE_URL="postgresql://placeholder:placeholder@placeholder.invalid:5432/placeholder"

JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=8000
CORS_ORIGIN="http://localhost:5173"

# Activation emails (new team members set their own password via a link --
# see src/services/activation.js). If SMTP_HOST is unset, the email is
# logged to the console instead of sent -- fine for local dev, not for
# anything real. Works with Gmail/Google Workspace SMTP + an app password,
# or any other SMTP provider.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@yourdomain.com"
# SMTP_PASS="changeme-app-password"
# MAIL_FROM="Truvara <you@yourdomain.com>"

# Encrypts Company.tenantDatabaseUrl at rest (AES-256-GCM, see
# src/utils/secretBox.js). 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Must be identical on every environment that reads the same directory DB
# (local + Render). Losing it means re-entering every tenant URL -- store a
# copy somewhere safe (password manager), never in the database or git.
TENANT_URL_ENCRYPTION_KEY="changeme-generate-with-openssl-rand-base64-32"

# Refuse to serve a company whose tenant DB connection could bypass
# Row-Level Security (owner account, superuser, RLS off). Leave false only
# until every existing company has been through `npm run secure:tenant`;
# MUST be true before self-service signup launches.
REQUIRE_RESTRICTED_TENANT_ROLE=false

# ── Self-service signup ──────────────────────────────────────────────────
# Keep false until the launch-critical security steps are complete and
# tested (Security Implementation Plan). While false, /signup shows "not
# open yet" and no workspace can be created.
SELF_SIGNUP_ENABLED=false
# Restricted (truvara_app) connection string of the SHARED tenant database,
# from `npm run secure:tenant -- SHARED_TENANT_DATABASE_URL --print-url`.
# Server only (Render). New workspaces are created here.
POOLED_TENANT_DATABASE_URL=""
# MAX_SELF_SERVICE_WORKSPACES=5
# Max open connections per tenant database, per server instance (default 5).
# TENANT_CONNECTION_LIMIT=5

# ── Operator-only (your machine, never Render) ───────────────────────────
# OWNER connection strings, used only by setup/migration scripts.
# SHARED_TENANT_DATABASE_URL=""     # shared tenant database, owner account
# NEW_DIRECTORY_DATABASE_URL=""     # directory's new home, for copy:directory
# Every tenant database's owner-URL env var, for `npm run migrate:tenants`.
# It refuses to run if a company's database is missing from this list.
# TENANT_OWNER_URL_VARS="SHARED_TENANT_DATABASE_URL,TAVORA_DATABASE_URL,FOUNDRY_DATABASE_URL,KNITENERGY_DATABASE_URL"
